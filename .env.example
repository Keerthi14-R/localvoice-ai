# Application Settings
APP_NAME=LocalVoice AI
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database & Storage
DATABASE_URL=sqlite:///./storage/localvoice.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_DURATION_MINUTES=15
KEEP_AUDIO_FILES=false

# Faster-Whisper Model Settings (Optimized for Windows 8GB RAM CPU-only)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=true
MAX_CONCURRENT_TRANSCRIPTIONS=1
